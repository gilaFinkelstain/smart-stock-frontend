# SmartStock Frontend — Environment Variables
#
# Copy to .env for local development.
# These are read by Vite at build/dev time (must be prefixed with VITE_).

# Backend API URL (Vite dev server proxies /api/* to this address)
VITE_API_URL=http://localhost:5000

# Vite dev server port
VITE_DEV_PORT=3000
